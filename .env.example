# JARVIS Configuration

# Server settings
HOST=0.0.0.0
PORT=8000

# Ollama settings
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=phi3-mini

# ChromaDB settings
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=jarvis_memory

# SQLite settings
DATABASE_PATH=./data/jarvis.db

# Caching settings
CACHE_TTL_SECONDS=60

# Memory settings
MEMORY_LIMIT=3